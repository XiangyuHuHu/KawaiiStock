# KawaiiStock 本地研究台。全部可选。不要提交真实密钥。
# 本程序没有券商下单通道，这些变量只影响只读行情和本地资料路径。

PORT=3479
HOST=127.0.0.1

# 资料目录。不设则使用仓库下的 vault/（见 src/paths.js）。
# OBSIDIAN_VAULT=
# OBSIDIAN_CHATGPT=
# OBSIDIAN_LISTS=
# OBSIDIAN_CN_LISTS=
# OBSIDIAN_HOLDINGS=
# OBSIDIAN_RECS=
# OBSIDIAN_WATCH=
# OBSIDIAN_ORACLE=
# OBSIDIAN_PAPER=
# KAWAII_DATA_DIR=
# KAWAII_REPORTS_DIR=
# KAWAII_LIST_DIR=
# CN_LIST_DIR=

# 观察池行情。MARKET_DATA_PROVIDER=twelve-data 且填写密钥时走 Twelve Data，否则用 Nasdaq 公开行情。
MARKET_DATA_PROVIDER=
TWELVE_DATA_API_KEY=

# 期权链只读行情，只给持仓盯市和纸上已有期权记账。沙盒是延迟数据，不能当实时。不扫描期权研究台，不下单。
TRADIER_TOKEN=
TRADIER_SANDBOX=0
