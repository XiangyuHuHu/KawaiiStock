# Optional read-only market data. Copy these names into your local .env; never commit credentials.
# This app does not place live orders. See also .env.example.

# Screener quotes. Use twelve-data only with a key; otherwise Nasdaq public quotes.
MARKET_DATA_PROVIDER=
TWELVE_DATA_API_KEY=

# Option chains. Sandbox quotes are delayed and never accepted as real-time input.
TRADIER_TOKEN=
TRADIER_SANDBOX=0

# Read-only forward collection while the app is running. 0 keeps it off.
OPTIONS_FORWARD_ENABLED=0
